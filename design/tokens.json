{
  "meta": {
    "name": "Aqua Launcher",
    "version": "0.0.13",
    "description": "Design tokens shared by the launcher UI and the editable Figma frames.",
    "baseFrame": { "width": 1440, "height": 900 },
    "appWindow": { "width": 1280, "height": 820, "minWidth": 960, "minHeight": 640 }
  },
  "color": {
    "bg": "#050f17",
    "bgDeep": "#030a10",
    "panel": "#0a1923",
    "panelRaised": "#0d202b",
    "field": "#0e2430",
    "line": "rgba(255, 255, 255, 0.08)",
    "lineStrong": "rgba(255, 255, 255, 0.14)",
    "text": "#e9f5f8",
    "textDim": "#aac2cc",
    "textMuted": "#7d97a4",
    "accent": "#5ce8dc",
    "accent2": "#3bc6ff",
    "accentSoft": "rgba(92, 232, 220, 0.13)",
    "accentInk": "#03211f",
    "ok": "#5fe3a1",
    "warn": "#ffc86b",
    "danger": "#ff8095",
    "okSoft": "rgba(95, 227, 161, 0.12)",
    "warnSoft": "rgba(255, 200, 107, 0.12)",
    "dangerSoft": "rgba(255, 128, 149, 0.12)",
    "scrim": "rgba(2, 8, 12, 0.62)",
    "mediaVeil": "rgba(4, 15, 22, 0.78)",
    "accents": {
      "aqua": "#5ce8dc",
      "mint": "#79f2b6",
      "azure": "#71b7ff",
      "violet": "#b79bff",
      "rose": "#ff9db5",
      "amber": "#ffd27a",
      "lime": "#c8f57b",
      "ice": "#bfe9ff",
      "crimson": "#ff8a9a",
      "sky": "#8fd6ff",
      "sand": "#ffe0a3",
      "plum": "#d8a5ff"
    },
    "light": {
      "bg": "#eef4f7",
      "bgDeep": "#e2ebf0",
      "panel": "#fbfdfe",
      "text": "#0b2028",
      "textDim": "#3d5964",
      "textMuted": "#68818c",
      "line": "rgba(10, 34, 44, 0.10)",
      "lineStrong": "rgba(10, 34, 44, 0.18)"
    }
  },
  "typography": {
    "family": { "sans": "Manrope", "mono": "JetBrains Mono" },
    "scale": {
      "display": { "size": 44, "lineHeight": 52, "weight": 800, "tracking": -1.4 },
      "h1": { "size": 30, "lineHeight": 38, "weight": 800, "tracking": -0.8 },
      "h2": { "size": 20, "lineHeight": 28, "weight": 800, "tracking": -0.3 },
      "h3": { "size": 15, "lineHeight": 22, "weight": 800, "tracking": -0.2 },
      "body": { "size": 13, "lineHeight": 20, "weight": 500, "tracking": 0 },
      "bodyStrong": { "size": 13, "lineHeight": 20, "weight": 700, "tracking": 0 },
      "small": { "size": 11, "lineHeight": 16, "weight": 500, "tracking": 0 },
      "micro": { "size": 9.5, "lineHeight": 12, "weight": 800, "tracking": 1.2 }
    }
  },
  "spacing": { "2xs": 4, "xs": 8, "sm": 12, "md": 16, "lg": 22, "xl": 30, "2xl": 40, "3xl": 48 },
  "layout": {
    "titlebar": 52,
    "rail": 248,
    "railCollapsed": 76,
    "pageMax": 1240,
    "pagePadding": 48,
    "gridColumns": 12,
    "gutter": 18,
    "cardMin": 260
  },
  "radius": { "xs": 6, "sm": 10, "md": 14, "lg": 18, "xl": 20, "2xl": 26, "pill": 999 },
  "shadow": {
    "sm": "0 10px 30px -18px rgba(0, 0, 0, 0.80)",
    "lg": "0 26px 70px -34px rgba(0, 0, 0, 0.85)",
    "accent": "0 18px 40px -22px rgba(92, 232, 220, 0.55)"
  },
  "motion": {
    "fast": { "duration": 150, "easing": "cubic-bezier(0.22, 0.68, 0, 1)" },
    "base": { "duration": 220, "easing": "cubic-bezier(0.22, 0.68, 0, 1)" },
    "slow": { "duration": 420, "easing": "cubic-bezier(0.22, 0.68, 0, 1)" },
    "reduced": "respect prefers-reduced-motion: crossfades only, no transforms"
  },
  "breakpoints": { "wide": 1280, "desktop": 1180, "tablet": 900, "small": 760, "mobile": 680 },
  "components": {
    "button": {
      "height": { "sm": 34, "md": 40, "lg": 46, "xl": 58 },
      "radius": 12,
      "primary": { "background": "linear-gradient(135deg, #5ce8dc, #3bc6ff)", "text": "#03211f" },
      "soft": { "background": "rgba(255, 255, 255, 0.055)", "border": "rgba(255, 255, 255, 0.14)", "text": "#e9f5f8" },
      "quiet": { "background": "transparent", "text": "#aac2cc" }
    },
    "field": { "height": 44, "radius": 12, "background": "#0e2430", "border": "rgba(255, 255, 255, 0.10)", "focusRing": "2px #5ce8dc" },
    "card": { "radius": 20, "padding": 20, "background": "#0a1923", "border": "rgba(255, 255, 255, 0.08)" },
    "chip": { "height": 24, "radius": 999, "textSize": 10.5, "tracking": 0.3 },
    "railItem": { "height": 42, "radius": 12, "activeBackground": "rgba(92, 232, 220, 0.13)", "activeBar": 3 },
    "achievementRing": { "size": 132, "stroke": 10 }
  }
}
