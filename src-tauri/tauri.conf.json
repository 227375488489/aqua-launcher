{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aqua Launcher",
  "version": "1.0.0",
  "identifier": "dev.aqua.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Aqua Launcher",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "center": true,
        "theme": "Dark",
        "dragDropEnabled": false,
        "backgroundColor": "#04121b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"]
      }
    }
  }
}
